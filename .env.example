# Sentence-transformers downloads this public model on first use; no key is needed.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=75
DEFAULT_TOP_K=5

# OpenAI generation and agent tool-calling. Never commit a real secret.
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
MAX_AGENT_STEPS=6
SUMMARY_BATCH_CHARS=8000
MAX_SUMMARY_BATCHES=12
