# Sentence-transformers downloads this public model on first use; no key is needed.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=75
DEFAULT_TOP_K=5
RETRIEVAL_MODE=dense
BM25_K1=1.5
BM25_B=0.75
# Hybrid retrieves this many candidates per backend (at least the requested top-k).
HYBRID_CANDIDATE_K=20
# RRF smoothing constant, not the number of returned chunks.
HYBRID_RRF_K=60

# Local Ollama generation and agent tool-calling. Start Ollama before running demos.
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen3:14b-q4_K_M
MAX_AGENT_STEPS=6
SUMMARY_BATCH_CHARS=8000
MAX_SUMMARY_BATCHES=12
